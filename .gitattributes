# Normalize line endings so the repo is identical whether it is cloned on
# Windows, macOS, or the Linux container Netlify builds in.
* text=auto

# Netlify parses these two literally. Keep them LF on every platform so a
# Windows checkout cannot introduce CRLF and break a header or redirect rule.
_headers text eol=lf
_redirects text eol=lf

# Shell-adjacent and config files that some tools read strictly.
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.webmanifest text eol=lf

# Binary assets. Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff2 binary
